FROM emscripten/emsdk:4.0.15 AS playground
WORKDIR /src
COPY vendor/toolchain vendor/toolchain
COPY playground playground
COPY scripts/build-playground.sh scripts/build-playground.sh
RUN sh scripts/build-playground.sh
COPY content content
COPY scripts/sync-content.py scripts/sync-content.py
RUN python3 scripts/sync-content.py
FROM node:22-alpine AS builder
WORKDIR /site
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
COPY --from=playground /src/frontend/public/ ./public/
RUN npm run build
FROM nginx:1.30-alpine
COPY --from=builder /site/dist /usr/share/nginx/html
COPY frontend/security-*.conf /etc/nginx/forge/
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY scripts/install.sh /usr/share/nginx/html/install.sh
COPY frontend/40-forge.sh /docker-entrypoint.d/40-forge.sh
EXPOSE 80
