import web;
import manifest;
import system;
import strings;
import os;
extern fn pm_tree_digest(path: string, excludes: int): string;
extern fn pm_file_sha256(path: string): string;
extern fn fs_receive_file(url: string, digest: string, path: string): int;
extern fn pm_archive_extract(file: string, directory: string): int;
extern fn pm_remove_tree(path: string): int;
extern fn pm_file_size(path: string): int;
fn artifact_url(url: string): int {
 if (web.starts(url,"https://") != 0) { return str_len(url)>8; }
 let start: int = 0;
 if (web.starts(url,"http://localhost") != 0) { start=16; }
 if (web.starts(url,"http://127.0.0.1") != 0) { start=16; }
 if (web.starts(url,"http://[::1]") != 0) { start=12; }
 if (start == 0 || str_len(url)<=start) { return 0; }
 if (str_char_at(url,start)==47) { return 1; }
 if (str_char_at(url,start)!=58) { return 0; }
 let i: int=start+1; while(i<str_len(url) && str_char_at(url,i)>=48 && str_char_at(url,i)<=57){i=i+1;}
 if(i==start+1 || i>=str_len(url) || str_char_at(url,i)!=47){return 0;}
 let port: int=web.integer(web.parse(str_sub(url,start+1,i-start-1)));
 return port>0 && port<=65535;
}
fn artifact_valid(artifact: int): int {
 if(web.kind(artifact)!=4 || web.required(artifact,"sha256",3)==0 || web.required(artifact,"url",3)==0 || web.required(artifact,"size",2)==0){return 0;}
 let digest: string=web.field_text(artifact,"sha256"); if(str_len(digest)!=64){return 0;}
 let i: int=0;while(i<64){let c: int=str_char_at(digest,i);if((c<48 || c>57) && (c<97 || c>102)){return 0;}i=i+1;}
 return web.field_int(artifact,"size")>0 && web.field_int(artifact,"size")<=268435456 && artifact_url(web.field_text(artifact,"url"))!=0;
}
fn staging_failure(directory: string, archive: string): int { pm_remove_tree(archive); pm_remove_tree(directory); return 0; }
fn artifact_exclusions(): int { let values: int=array();add(values,"build");add(values,"node_modules");add(values,".forge-npm-fingerprint");add(values,".forge-artifact");add(values,".forge-source.tar.gz");return values; }
fn artifact_checkout_valid_at(value: int,directory: string): int {
 let artifact: int=web.get(value,"artifact");if(artifact_valid(artifact)==0||system.safe_checkout_tree(directory)==0){return 0;}
 let archive: string=str_concat(directory,"/.forge-source.tar.gz");
 if(pm_file_size(archive)!=web.field_int(artifact,"size")||web.equal(pm_file_sha256(archive),web.field_text(artifact,"sha256"))==0){return 0;}
 let temp: string=str_concat(".forge/staging-verify-",web.uuid());
 if(pm_archive_extract(archive,temp)==0){pm_remove_tree(temp);return 0;}
 let expected: string=pm_tree_digest(temp,artifact_exclusions());let actual: string=pm_tree_digest(directory,artifact_exclusions());pm_remove_tree(temp);
 return str_len(expected)>0 && web.equal(expected,actual)!=0 && system.exists(str_concat(str_concat(directory,"/"),web.field_text(value,"module")))!=0;
}
fn artifact_download(value: int, dest: string): int {
 let artifact: int=web.get(value,"artifact"); if(artifact_valid(artifact)==0){return 0;}
 if(system.exists(dest)!=0){return artifact_checkout_valid_at(value,dest);}
 let marker: int=0;
 let temp: string=str_concat(".forge/staging-",web.uuid()); let archive: string=str_concat(temp,".tar.gz");
 if(fs_receive_file(web.field_text(artifact,"url"),web.field_text(artifact,"sha256"),archive)==0){return staging_failure(temp,archive);}
 if(pm_file_size(archive)!=web.field_int(artifact,"size")){return staging_failure(temp,archive);}
 if(pm_archive_extract(archive,temp)==0){return staging_failure(temp,archive);}
 if(system.exists(str_concat(str_concat(temp,"/"),web.field_text(value,"module")))==0){return staging_failure(temp,archive);}
 if(system.rename(archive,str_concat(temp,"/.forge-source.tar.gz"))==0){return staging_failure(temp,archive);}
 marker=web.object();web.set(marker,"sha256",web.get(artifact,"sha256"));web.set(marker,"git_commit",web.get(value,"git_commit"));
 if(system.write(str_concat(temp,"/.forge-artifact"),web.dump(marker))==0){return staging_failure(temp,archive);}
 if(system.exists(dest)!=0 && pm_remove_tree(dest)==0){return staging_failure(temp,archive);}
 if(system.rename(temp,dest)==0){return staging_failure(temp,archive);} return 1;
}
fn fail(message: string): int { println(str_concat("forge-pm: ",message));return 1; }
fn registry(): string { let url: string=web.env("FORGE_REGISTRY","builtin"); while(str_len(url)>0 && str_char_at(url,str_len(url)-1)==47){url=str_sub(url,0,str_len(url)-1);}return url; }
fn config(): int { return web.parse(web.read("forge.json")); }
fn request(path: string,method: string,body: string): int { return web.request(str_concat(registry(),path),method,body,web.env("FORGE_TOKEN","")); }
fn catalog(): int {return web.parse(web.read(str_concat(web.env("FORGE_ROOT",""),"/registry-seed.json")));}
fn newer(a: string,b: string): int {
 let part: int=0;while(part<3){let x: int=manifest.component(a,part);let y: int=manifest.component(b,part);if(x!=y){return x>y;}part=part+1;}return 0;
}
fn official(name: string,version: string): int {
 let items: int=catalog();let chosen: int=0;let i: int=0;while(i<web.count(items)){
  let item: int=web.at(items,i);if(web.equal(web.field_text(item,"name"),name)!=0 && (web.equal(version,"latest")!=0||web.equal(version,web.field_text(item,"version"))!=0)){
   if(chosen==0||newer(web.field_text(item,"version"),web.field_text(chosen,"version"))!=0){chosen=item;}
  }i=i+1;
 }return chosen;
}
fn release(name: string,version: string): int {
 if(manifest.name(name)==0){return 0;}
 if(web.equal(registry(),"builtin")!=0){return official(name,version);}
 if(web.equal(version,"latest")!=0){let r: int=request(str_concat("/api/packages/",name),"GET","");if(web.field_int(r,"status")!=200){return 0;}return web.at(web.get(web.get(r,"data"),"versions"),0);}
 if(manifest.version(version)==0){return 0;}
 let r: int=request(str_concat(str_concat(str_concat("/api/packages/",name),"/versions/"),version),"GET",""); if(web.field_int(r,"status")!=200){return 0;}return web.get(r,"data");
}
fn cache(value: int): string { return str_concat(str_concat(str_concat(str_concat(".forge/packages/",web.field_text(value,"name")),"/"),web.field_text(value,"git_commit")),""); }
fn canonical_repo(url: string): string {
 let value: string=web.lower(url);let n: int=str_len(value);
 if(n>4 && web.equal(str_sub(value,n-4,4),".git")!=0){value=str_sub(value,0,n-4);}return value;
}
fn git_args(): int {
 let args: int=system.argv("git");system.arg(args,"--no-replace-objects");system.arg(args,"-c");system.arg(args,"core.hooksPath=/dev/null");system.arg(args,"-c");system.arg(args,"core.fsmonitor=false");return args;
}
fn checkout_valid_at(value: int,directory: string): int {
 if(manifest.valid(value)==0){return 0;}if(web.kind(web.get(value,"artifact"))!=0){return artifact_checkout_valid_at(value,directory);}
 if(system.safe_git_checkout_tree(directory)==0){return 0;}
 let args: int=git_args();system.arg(args,"config");system.arg(args,"--local");system.arg(args,"--no-includes");system.arg(args,"--list");let r: int=system.run(args,directory);let cfg: string=web.lower(web.field_text(r,"output"));
 if(web.field_int(r,"status")!=0||web.starts(cfg,"filter.")!=0||str_contains(cfg,"\nfilter.")!=0||web.starts(cfg,"include.")!=0||str_contains(cfg,"\ninclude.")!=0||web.starts(cfg,"includeif.")!=0||str_contains(cfg,"\nincludeif.")!=0||web.starts(cfg,"extensions.")!=0||str_contains(cfg,"\nextensions.")!=0){return 0;}
 args=git_args();system.arg(args,"rev-parse");system.arg(args,"HEAD");r=system.run(args,directory);
 if(web.field_int(r,"status")!=0||web.equal(web.trim(web.field_text(r,"output")),web.field_text(value,"git_commit"))==0){return 0;}
 args=git_args();system.arg(args,"config");system.arg(args,"--local");system.arg(args,"--no-includes");system.arg(args,"--get");system.arg(args,"remote.origin.url");r=system.run(args,directory);
 if(web.field_int(r,"status")!=0||web.equal(canonical_repo(web.trim(web.field_text(r,"output"))),canonical_repo(web.field_text(value,"repository_url")))==0){return 0;}
 args=git_args();system.arg(args,"status");system.arg(args,"--porcelain");system.arg(args,"--untracked-files=no");r=system.run(args,directory);
 if(web.field_int(r,"status")!=0||str_len(web.trim(web.field_text(r,"output")))!=0){return 0;}
 args=git_args();system.arg(args,"ls-files");system.arg(args,"-v");r=system.run(args,directory);let indexed: string=web.field_text(r,"output");let cursor: int=0;
 if(web.field_int(r,"status")!=0){return 0;}while(cursor<str_len(indexed)){if(str_char_at(indexed,cursor)!=72){return 0;}while(cursor<str_len(indexed)&&str_char_at(indexed,cursor)!=10){cursor=cursor+1;}cursor=cursor+1;}
 args=git_args();system.arg(args,"ls-files");system.arg(args,"--others");r=system.run(args,directory);let others: string=web.field_text(r,"output");cursor=0;
 if(web.field_int(r,"status")!=0){return 0;}while(cursor<str_len(others)){let start: int=cursor;while(cursor<str_len(others)&&str_char_at(others,cursor)!=10){cursor=cursor+1;}let file: string=str_sub(others,start,cursor-start);if(web.starts(file,"build/")==0&&web.starts(file,"node_modules/")==0&&web.equal(file,".forge-npm-fingerprint")==0){return 0;}cursor=cursor+1;}
 args=git_args();system.arg(args,"ls-tree");system.arg(args,"-r");system.arg(args,"HEAD");r=system.run(args,directory);let tree: string=web.field_text(r,"output");
 if(web.field_int(r,"status")!=0||web.starts(tree,"120000")!=0||web.starts(tree,"160000")!=0||str_contains(tree,"\n120000")!=0||str_contains(tree,"\n160000")!=0){return 0;}
 args=git_args();system.arg(args,"ls-files");system.arg(args,"--error-unmatch");system.arg(args,"--");system.arg(args,web.field_text(value,"module"));r=system.run(args,directory);if(web.field_int(r,"status")!=0){return 0;}
 return system.exists(str_concat(str_concat(directory,"/"),web.field_text(value,"module")));
}
fn checkout_valid(value: int): int { return checkout_valid_at(value,cache(value)); }
fn trusted(project: int,value: int,permission: string): int {
 let grant: int=web.get(web.get(project,"trust"),web.field_text(value,"name"));
 return web.kind(grant)==4 && web.equal(web.field_text(grant,"repository_url"),canonical_repo(web.field_text(value,"repository_url")))!=0 && web.equal(web.field_text(grant,"git_commit"),web.field_text(value,"git_commit"))!=0 && web.boolean(web.get(grant,permission))!=0;
}
fn trust(project: int): int {
 let name: string=os_argv(2);let permission: string="native";let flag: string=os_argv(3);
 if(str_len(flag)>0 && web.equal(flag,"--npm-scripts")==0){return fail("Usage: forge trust <package> [--npm-scripts]");}
 if(str_len(flag)>0){permission="npm_scripts";}
 let lock: int=web.parse(web.read("forge.lock"));let value: int=web.get(web.get(lock,"packages"),name);
 if(manifest.name(name)==0||checkout_valid(value)==0){return fail("Trust requires a verified package in forge.lock; run install first");}
 let grants: int=web.get(project,"trust");if(web.kind(grants)!=4){grants=web.object();web.set(project,"trust",grants);}
 let grant: int=web.get(grants,name);if(web.kind(grant)!=4||web.equal(web.field_text(grant,"repository_url"),canonical_repo(web.field_text(value,"repository_url")))==0||web.equal(web.field_text(grant,"git_commit"),web.field_text(value,"git_commit"))==0){grant=web.object();}
 web.set(grant,"repository_url",web.jstring(canonical_repo(web.field_text(value,"repository_url"))));web.set(grant,"git_commit",web.get(value,"git_commit"));web.set(grant,permission,web.jbool(1));web.set(grants,name,grant);
 if(system.write("forge.json",web.dump(project))==0){return fail("Cannot write forge.json trust grant");}
 println(str_concat(str_concat(str_concat(str_concat(str_concat("Trusted ",permission)," execution for "),canonical_repo(web.field_text(value,"repository_url")))," @ "),web.field_text(value,"git_commit")));return 0;
}
fn download(value: int): int {
 let dest: string=cache(value);
 let parent: string=str_concat(".forge/packages/",web.field_text(value,"name")); if(system.mkdir(parent)==0){return 0;}
 if(web.kind(web.get(value,"artifact"))!=0){return artifact_download(value,dest);}
 if(system.exists(dest)!=0){return checkout_valid(value);}
 let temp: string=str_concat(str_concat(".forge/staging-",web.uuid()),"");
 let args: int=system.argv("git");system.arg(args,"-c");system.arg(args,"core.hooksPath=/dev/null");system.arg(args,"-c");system.arg(args,"protocol.file.allow=never");system.arg(args,"clone");system.arg(args,"--template=");system.arg(args,"--no-checkout");system.arg(args,"--");system.arg(args,web.field_text(value,"repository_url"));system.arg(args,temp);
 if(system.success(args,"")==0){return 0;}
 args=system.argv("git");system.arg(args,"-c");system.arg(args,"core.hooksPath=/dev/null");system.arg(args,"checkout");system.arg(args,"--detach");system.arg(args,web.field_text(value,"git_commit"));if(system.success(args,temp)==0){return 0;}
 args=system.argv("git");system.arg(args,"rev-parse");system.arg(args,"HEAD");let result: int=system.run(args,temp);
 if(web.field_int(result,"status")!=0||web.equal(web.trim(web.field_text(result,"output")),web.field_text(value,"git_commit"))==0){return 0;}
 if(checkout_valid_at(value,temp)==0){return 0;}
 return system.rename(temp,dest);
}
fn resolve(name: string,version: string,selected: int,visiting: int,depth: int): int {
 if(depth>=32){println("Dependency graph exceeds 64 modules or 32 levels");return 0;}
 if(web.boolean(web.get(visiting,name))!=0){println(str_concat("Dependency cycle: ",name));return 0;}
 let existing: int=web.get(selected,name);
 if(web.kind(existing)!=0){if(web.equal(web.field_text(existing,"version"),version)==0){println(str_concat("Conflicting versions: ",name));return 0;}return 1;}
 if(web.count(selected)>=64){println("Dependency graph exceeds 64 modules");return 0;}
 let value: int=release(name,version);if(manifest.valid(value)==0){println(str_concat("Invalid or missing release: ",name));return 0;}
 if(web.equal(web.field_text(value,"name"),name)==0||web.equal(web.field_text(value,"version"),version)==0){return 0;}
 web.set(visiting,name,web.jbool(1));let deps: int=web.get(value,"dependencies");let keys: int=web.keys(deps);let i: int=0;
 while(i<web.count(keys)){let child: string=web.text(web.at(keys,i));if(resolve(child,web.field_text(deps,child),selected,visiting,depth+1)==0){return 0;}i=i+1;}
 web.set(visiting,name,web.jbool(0));web.set(selected,name,value);return 1;
}
fn install(value: int): int {
 let deps: int=web.get(value,"dependencies");if(web.kind(deps)!=4){return fail("forge.json requires dependencies object");}
 let selected: int=web.object();let visiting: int=web.object();let keys: int=web.keys(deps);let i: int=0;
 while(i<web.count(keys)){let name: string=web.text(web.at(keys,i));if(resolve(name,web.field_text(deps,name),selected,visiting,0)==0){return 1;}i=i+1;}
 keys=web.keys(selected);i=0;while(i<web.count(keys)){let name: string=web.text(web.at(keys,i));println(str_concat("Installing ",name));if(download(web.get(selected,name))==0){return fail("Git installation failed; previous lock file was preserved");}i=i+1;}
 let lock: int=web.object();web.set(lock,"registry",web.jstring(registry()));web.set(lock,"roots",deps);web.set(lock,"packages",selected);web.set(lock,"format",web.number(1));
 if(system.write("forge.lock",web.dump(lock))==0){return fail("Cannot write forge.lock");}println("Dependencies pinned in forge.lock");return 0;
}
fn module_dir(value: int): string {
 let file: string=web.field_text(value,"module");let i: int=0;let slash: int=0;
 while(i<str_len(file)){if(str_char_at(file,i)==47){slash=i+1;}i=i+1;}
 if(slash==0){return cache(value);}return str_concat(str_concat(cache(value),"/"),str_sub(file,0,slash));
}
fn array(): int { return web.array(); }
fn add(values: int,value: string): int { return web.push(values,web.jstring(value)); }
fn exclusions(): int { let values: int=array();add(values,".git");add(values,".forge");add(values,"build");add(values,"node_modules");add(values,".forge-npm-fingerprint");add(values,".forge-source.tar.gz");add(values,".forge-artifact");return values; }
fn hash_paths(paths: int): string { return system.hash(paths,exclusions(),array()); }
fn tool_version(command: string,argument: string): string { let args: int=system.argv(command);if(str_len(argument)>0){system.arg(args,argument);}let result: int=system.run(args,"");if(web.field_int(result,"status")!=0){return "unavailable";}return web.trim(web.field_text(result,"output")); }
fn environment(): string {
 let names: int=array();add(names,"PATH");add(names,"CC");add(names,"PKG_CONFIG_PATH");add(names,"PKG_CONFIG_LIBDIR");add(names,"PKG_CONFIG_SYSROOT_DIR");add(names,"CMAKE_GENERATOR");add(names,"CMAKE_TOOLCHAIN_FILE");add(names,"CFLAGS");add(names,"CPPFLAGS");add(names,"LDFLAGS");add(names,"CPATH");add(names,"C_INCLUDE_PATH");add(names,"LIBRARY_PATH");add(names,"SDKROOT");add(names,"npm_config_registry");add(names,"npm_config_arch");add(names,"npm_config_platform");
 let result: string="";let i: int=0;while(i<web.count(names)){let name: string=web.text(web.at(names,i));result=str_concat(str_concat(str_concat(str_concat(result,name),"="),web.dump(web.jstring(web.env(name,"")))),"\n");i=i+1;}return result;
}
fn target(): string { return tool_version("uname","-srm"); }
fn cache_key(input: string,outputs: int): string { let output: string=hash_paths(outputs);if(str_len(input)==0||str_len(output)==0){return "";}return system.sha256(str_concat(str_concat(input,"\n"),output)); }
fn cache_hit(file: string,input: string,outputs: int): int { let key: string=cache_key(input,outputs);return str_len(key)>0 && web.equal(web.trim(web.read(file)),key)!=0; }
fn cache_publish(file: string,input: string,outputs: int): int { let key: string=cache_key(input,outputs);if(str_len(key)==0){return 0;}return system.write(file,str_concat(key,"\n"))==0; }
fn build_input(javascript: int,root: string,modules: int): string {
 let paths: int=array();add(paths,".");add(paths,str_concat(root,"/build/bin/forge"));add(paths,str_concat(root,"/include"));
 if(javascript!=0){add(paths,str_concat(root,"/libexec/esbuild"));add(paths,system.executable("node"));add(paths,system.executable("npm"));}else{add(paths,str_concat(root,"/build/lib/libforge_runtime.a"));add(paths,str_concat(root,"/build/lib/libforge_std.a"));add(paths,system.executable(web.env("CC","cc")));}
 let keys: int=web.keys(modules);let i: int=0;while(i<web.count(keys)){
  let m: int=web.get(modules,web.text(web.at(keys,i)));add(paths,cache(m));
  if(javascript!=0 && web.kind(web.get(m,"javascript"))==4){let node_modules: string=str_concat(cache(m),"/node_modules");if(system.exists(node_modules)==0){return "";}add(paths,node_modules);}
  if(javascript==0 && web.kind(web.get(m,"native"))==4){return "";}
  i=i+1;
 }
 let files: string=system.hash(paths,exclusions(),array());if(str_len(files)==0){return "";}
 let mode: string="native";if(javascript!=0){mode="javascript";}let tools: string=str_concat(str_concat(str_concat(str_concat(str_concat(str_concat("format=2\nmode=",mode),"\ntarget="),target()),"\nenv="),environment()),"\nfiles=");tools=str_concat(tools,files);
 if(javascript!=0){tools=str_concat(str_concat(str_concat(str_concat(str_concat(tools,"\ncompiler-flags=--emit-js\nbundler-flags=--bundle --format=iife --target=es2022"),"\nnode="),tool_version("node","--version")),"\nnpm="),tool_version("npm","--version"));}else{tools=str_concat(str_concat(str_concat(tools,"\ncompiler-flags=--emit-c\ncc-flags=-std=gnu11 -O2 -lpthread -lm"),"\ncc="),tool_version(web.env("CC","cc"),"--version"));}
 return system.sha256(tools);
}
fn cmake_input(module: string): string {
 let paths: int=array();add(paths,module);let suffixes: int=array();add(suffixes,"CMakeLists.txt");add(suffixes,".cmake");let files: string=system.hash(paths,exclusions(),suffixes);let executable: int=array();add(executable,system.executable("cmake"));let tool: string=hash_paths(executable);if(str_len(files)==0||str_len(tool)==0){return "";}files=str_concat(files,tool);
 return system.sha256(str_concat(str_concat(str_concat(str_concat(str_concat("format=1\nconfigure-flags=-DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF\nfiles=",files),"\ncmake="),tool_version("cmake","--version")),"\ntarget="),str_concat(target(),str_concat("\nenv=",environment()))));
}
fn cmake_outputs(directory: string): int { let outputs: int=array();add(outputs,str_concat(directory,"/CMakeCache.txt"));let ninja: string=str_concat(directory,"/build.ninja");let makefile: string=str_concat(directory,"/Makefile");if(system.exists(ninja)!=0){add(outputs,ninja);}if(system.exists(makefile)!=0){add(outputs,makefile);}return outputs; }
fn npm_input(module: string,package_file: string,scripts: int): string {
 let script_policy: string="disabled";if(scripts!=0){script_policy="explicitly-trusted";}
 let paths: int=array();add(paths,package_file);add(paths,str_concat(module,"/package-lock.json"));add(paths,system.executable("node"));add(paths,system.executable("npm"));let files: string=system.hash(paths,array(),array());if(str_len(files)==0){return "";}
 return system.sha256(str_concat(str_concat(str_concat(str_concat(str_concat(str_concat(str_concat(str_concat("format=2\nnpm-flags=ci --no-bin-links\nscripts=",str_concat(script_policy,"\nfiles=")),files),"\nnode="),tool_version("node","--version")),"\nnpm="),tool_version("npm","--version")),"\ntarget="),str_concat(target(),str_concat("\nenv=",environment()))));
}
fn build(value: int,run: int): int {
 let lock: int=web.parse(web.read("forge.lock"));let deps: int=web.get(value,"dependencies");if(web.kind(deps)!=4){return fail("Missing dependencies object");}
 if(web.count(deps)>0 && (web.equal(web.dump(web.get(lock,"roots")),web.dump(deps))==0 || web.equal(web.field_text(lock,"registry"),registry())==0)){return fail("Run forge-pm install to refresh forge.lock");}
 let source: string=web.field_text(value,"entry");if(manifest.path(source)==0){return fail("Invalid entry path");}if(system.mkdir("build")==0){return 1;}
 let root: string=web.env("FORGE_ROOT","");if(str_len(root)==0){return fail("FORGE_ROOT is required; use the installed forge wrapper");}
 let javascript: int=web.equal(os_argv(2),"--emit-js");let forge: string=str_concat(root,"/build/bin/forge");
 let modules: int=web.get(lock,"packages");let keys: int=web.keys(modules);let i: int=0;
 while(i<web.count(keys)){let m: int=web.get(modules,web.text(web.at(keys,i)));if(checkout_valid(m)==0){return fail("Invalid lock or missing module; run install");}i=i+1;}
 i=0;while(i<web.count(keys)){let m: int=web.get(modules,web.text(web.at(keys,i)));if(javascript==0 && web.kind(web.get(m,"native"))==4 && trusted(value,m,"native")==0){return fail(str_concat(str_concat("Native dependency can execute build commands; review its pinned source then run: forge trust ",web.field_text(m,"name")),""));}i=i+1;}
 let outputs: int=array();if(javascript!=0){add(outputs,"build/main.js");add(outputs,"build/entry.js");add(outputs,"build/app.js");}else{add(outputs,"build/main.c");add(outputs,"build/app");}
 let fingerprint: string=build_input(javascript,root,modules);if(cache_hit("build/.forge-build-fingerprint",fingerprint,outputs)!=0){println("Build cache hit");if(run!=0 && javascript==0){let cached: int=system.argv("./build/app");let cached_result: int=system.run(cached,"");println(web.field_text(cached_result,"output"));return web.field_int(cached_result,"status");}return 0;}
 let args: int=system.argv(forge);system.arg(args,source);if(javascript!=0){system.arg(args,"--emit-js");}else{system.arg(args,"--emit-c");}system.arg(args,"-o");if(javascript!=0){system.arg(args,"build/main.js");}else{system.arg(args,"build/main.c");}system.arg(args,"--forge-root");system.arg(args,root);
 i=0;
 while(i<web.count(keys)){let m: int=web.get(modules,web.text(web.at(keys,i)));if(checkout_valid(m)==0){return fail("Invalid lock or missing module; run install");}system.arg(args,"-I");system.arg(args,module_dir(m));i=i+1;}
 if(system.success(args,"")==0){return fail("Forge compilation failed");}
 if(javascript!=0){
  let imports: string="";i=0;
  while(i<web.count(keys)){
   let m: int=web.get(modules,web.text(web.at(keys,i)));let bridge: int=web.get(m,"javascript");
   if(web.kind(bridge)==4){
    let package: string=str_concat(str_concat(cache(m),"/"),web.field_text(bridge,"package_file"));if(system.exists(package)==0){return fail("JavaScript module package file missing");}
     let install_outputs: int=array();add(install_outputs,str_concat(cache(m),"/node_modules"));let scripts: int=trusted(value,m,"npm_scripts");let install_input: string=npm_input(cache(m),package,scripts);
     if(cache_hit(str_concat(cache(m),"/.forge-npm-fingerprint"),install_input,install_outputs)==0){let npm: int=system.argv("npm");system.arg(npm,"ci");system.arg(npm,"--prefix");system.arg(npm,cache(m));if(scripts==0){system.arg(npm,"--ignore-scripts");}else{system.arg(npm,"--ignore-scripts=false");}system.arg(npm,"--no-bin-links");if(system.success(npm,"")==0){return fail("JavaScript dependencies require Node.js 22 and npm");}install_input=npm_input(cache(m),package,scripts);if(cache_publish(str_concat(cache(m),"/.forge-npm-fingerprint"),install_input,install_outputs)!=0){return fail("Cannot publish npm cache fingerprint");}}
    let entry: string=str_concat(str_concat(str_concat(str_concat(system.cwd(),"/"),cache(m)),"/"),web.field_text(bridge,"entry"));imports=str_concat(str_concat(str_concat(imports,"import "),web.dump(web.jstring(entry))),";\n");
   }i=i+1;
  }
  imports=str_concat(imports,"import './main.js';\n");if(system.write("build/entry.js",imports)==0){return 1;}
  let bundler: int=system.argv(str_concat(root,"/libexec/esbuild"));system.arg(bundler,"build/entry.js");system.arg(bundler,"--bundle");system.arg(bundler,"--format=iife");system.arg(bundler,"--target=es2022");system.arg(bundler,"--outfile=build/app.js");
   if(system.success(bundler,"")==0){return fail("Browser bundling failed");}fingerprint=build_input(javascript,root,modules);if(cache_publish("build/.forge-build-fingerprint",fingerprint,outputs)!=0){return fail("Cannot publish build cache fingerprint");}println("Built build/app.js; load it in an HTML page with <div id=app></div>");return 0;
 }
 let cc: int=system.argv(web.env("CC","cc"));system.arg(cc,"-std=gnu11");system.arg(cc,"-O2");system.arg(cc,"build/main.c");system.arg(cc,"-o");system.arg(cc,"build/app");system.arg(cc,"-I");system.arg(cc,str_concat(root,"/include"));
 system.arg(cc,"-Wl,--start-group");
 let pkg: int=system.argv("pkg-config");system.arg(pkg,"--cflags");system.arg(pkg,"--libs");let pkg_count: int=0;i=0;
 while(i<web.count(keys)){
  let m: int=web.get(modules,web.text(web.at(keys,i)));let native_info: int=web.get(m,"native");
   if(web.kind(native_info)==4){let dir: string=str_concat(cache(m),"/build");let configure_outputs: int=cmake_outputs(dir);let configure_input: string=cmake_input(cache(m));if(cache_hit(str_concat(dir,"/.forge-config-fingerprint"),configure_input,configure_outputs)==0){args=system.argv("cmake");system.arg(args,"-S");system.arg(args,cache(m));system.arg(args,"-B");system.arg(args,dir);system.arg(args,"-DCMAKE_BUILD_TYPE=Release");system.arg(args,"-DBUILD_TESTING=OFF");if(system.success(args,"")==0){return fail("Native module configuration failed");}configure_input=cmake_input(cache(m));configure_outputs=cmake_outputs(dir);if(cache_publish(str_concat(dir,"/.forge-config-fingerprint"),configure_input,configure_outputs)!=0){return fail("Cannot publish native configuration fingerprint");}}
   args=system.argv("cmake");system.arg(args,"--build");system.arg(args,dir);system.arg(args,"--target");system.arg(args,web.field_text(native_info,"cmake_target"));system.arg(args,"-j");system.arg(args,"4");if(system.success(args,"")==0){return fail("Native module build failed");}
   system.arg(cc,str_concat(str_concat(str_concat(dir,"/lib"),web.field_text(native_info,"library")),".a"));let packages: int=web.get(native_info,"pkg_config");let j: int=0;while(j<web.count(packages)){system.arg(pkg,web.text(web.at(packages,j)));pkg_count=pkg_count+1;j=j+1;}
  }i=i+1;
 }
 system.arg(cc,str_concat(root,"/build/lib/libforge_runtime.a"));system.arg(cc,str_concat(root,"/build/lib/libforge_std.a"));system.arg(cc,"-Wl,--end-group");
 if(pkg_count>0){let result: int=system.run(pkg,"");if(web.field_int(result,"status")!=0){return fail("Install development libraries listed by pkg-config");}let flags: string=web.trim(web.field_text(result,"output"));let start: int=0;i=0;while(i<=str_len(flags)){if(i==str_len(flags)||str_char_at(flags,i)==32||str_char_at(flags,i)==10){if(i>start){system.arg(cc,str_sub(flags,start,i-start));}start=i+1;}i=i+1;}}
  system.arg(cc,"-lpthread");system.arg(cc,"-lm");if(system.success(cc,"")==0){return fail("C compiler/linker failed");}fingerprint=build_input(javascript,root,modules);if(cache_publish("build/.forge-build-fingerprint",fingerprint,outputs)!=0){return fail("Cannot publish build cache fingerprint");}println("Built build/app");
 if(run!=0){args=system.argv("./build/app");let result: int=system.run(args,"");println(web.field_text(result,"output"));return web.field_int(result,"status");}return 0;
}
fn init(): int {
 if(os_argc()>3){return fail("Usage: forge init [name|.]");}
 let name: string=os_argv(2);
 if(str_len(name)==0){name="forge-app";}
 let directory: string=name;
 if(web.equal(directory,".")!=0){name="forge-app";}
 else {
  if(manifest.name(name)==0){return fail("Invalid project name: use 3-64 lowercase letters, digits or hyphens, starting with a letter and not ending with a hyphen");}
  if(system.mkdir_new(directory)==0){return fail("Cannot create project directory (it may already exist)");}
 }
 let manifest_file: string=str_concat(directory,"/forge.json");
 let source_file: string=str_concat(directory,"/main.fg");
 if(system.exists(manifest_file)!=0){return fail("forge.json already exists");}
 let value: int=web.object();
 web.set(value,"name",web.jstring(name));
 web.set(value,"entry",web.jstring("main.fg"));
 web.set(value,"dependencies",web.object());
 if(system.exists(source_file)==0){
  if(system.write(source_file,"native main { println(\"Hello, Forge!\"); return 0; }\n")==0){return fail("Cannot write main.fg");}
 }
 if(system.write(manifest_file,web.dump(value))==0){return fail("Cannot write forge.json");}
 println(str_concat("Created project in ",directory));
 if(web.equal(directory,".")!=0){println("Run: forge run");}
 else {println(str_concat(str_concat("Run: cd ",directory)," && forge run"));}
 return 0;
}
fn run(): int {
 let command: string=os_argv(1);
 if(web.equal(command,"--version")!=0){println("forge-pm 0.1.1");return 0;}
 if(web.equal(command,"init")!=0){return init();}
 if(web.equal(command,"search")!=0){if(web.equal(registry(),"builtin")!=0){let out: int=web.array();let items: int=catalog();let i: int=0;let query: string=web.lower(os_argv(2));while(i<web.count(items)){let m: int=web.at(items,i);if(str_contains(web.lower(web.field_text(m,"name")),query)!=0||str_contains(web.lower(web.field_text(m,"description")),query)!=0){web.push(out,m);}i=i+1;}println(web.dump(out));return 0;}let r: int=request(str_concat("/api/packages?q=",web.urlencode(os_argv(2))),"GET","");if(web.field_int(r,"status")!=200){return fail("Registry unavailable");}println(web.dump(web.get(r,"data")));return 0;}
 if(web.equal(command,"publish")!=0){if(web.equal(registry(),"builtin")!=0){return fail("Set FORGE_REGISTRY to your Forge registry website before publishing");}let file: string=os_argv(2);if(str_len(file)==0){file="module.json";}let value: int=web.parse(web.read(file));if(manifest.valid(value)==0){return fail("Invalid module.json release manifest");}let review: string=os_argv(3);if(os_argc()>4||(str_len(review)>0&&web.equal(review,"--acknowledge-review")==0)){return fail("Usage: forge publish [module.json] [--acknowledge-review]");}if(str_len(review)>0){web.set(value,"acknowledge_review",web.jbool(1));}if(str_len(web.env("FORGE_TOKEN",""))==0){return fail("Set FORGE_TOKEN using your website login token");}let r: int=request("/api/packages","POST",web.dump(value));if(web.field_int(r,"status")!=201){println(web.dump(web.get(r,"data")));return 1;}println("Release published");return 0;}
 let value: int=config();if(web.kind(value)!=4){return fail("Run forge-pm init first. Commands: init, search, add, remove, install, list, trust, publish, build, run");}
 if(web.equal(command,"trust")!=0){return trust(value);}
 if(web.equal(command,"add")!=0){let name: string=os_argv(2);let version: string=os_argv(3);if(str_len(version)==0){version="latest";}let m: int=release(name,version);if(manifest.valid(m)==0){return fail("Package release not found");}web.set(web.get(value,"dependencies"),name,web.get(m,"version"));if(install(value)!=0){return 1;}return system.write("forge.json",web.dump(value))==0;}
 if(web.equal(command,"remove")!=0){let deps: int=web.get(value,"dependencies");let updated: int=web.object();let keys: int=web.keys(deps);let i: int=0;while(i<web.count(keys)){let name: string=web.text(web.at(keys,i));if(web.equal(name,os_argv(2))==0){web.set(updated,name,web.get(deps,name));}i=i+1;}web.set(value,"dependencies",updated);if(install(value)!=0){return 1;}return system.write("forge.json",web.dump(value))==0;}
 if(web.equal(command,"install")!=0){return install(value);}
 if(web.equal(command,"list")!=0){println(web.read("forge.lock"));return 0;}
 if(web.equal(command,"build")!=0){return build(value,0);}if(web.equal(command,"run")!=0){return build(value,1);}
 return fail("Unknown command. Commands: init, search, add, remove, install, list, trust, publish, build, run");
}
