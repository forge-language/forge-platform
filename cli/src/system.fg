import web;
extern fn pm_run(args: int, directory: string): int;
extern fn pm_mkdir(path: string): int;
extern fn pm_write(path: string, text: string): int;
extern fn pm_exists(path: string): int;
extern fn pm_rename(a: string, b: string): int;
extern fn pm_cwd(): string;
extern fn pm_sha256(text: string): string;
extern fn pm_hash(paths: int, excludes: int, suffixes: int): string;
extern fn pm_executable(command: string): string;
fn run(args: int, directory: string): int { return pm_run(args,directory); }
fn mkdir(path: string): int { return pm_mkdir(path); }
fn write(path: string, text: string): int { return pm_write(path,text); }
fn exists(path: string): int { return pm_exists(path); }
fn rename(a: string,b: string): int { return pm_rename(a,b); }
fn cwd(): string { return pm_cwd(); }
fn sha256(text: string): string { return pm_sha256(text); }
fn hash(paths: int, excludes: int, suffixes: int): string { return pm_hash(paths,excludes,suffixes); }
fn executable(command: string): string { return pm_executable(command); }
fn argv(command: string): int { let out: int=web.array(); web.push(out,web.jstring(command)); return out; }
fn arg(args: int, value: string): int { return web.push(args,web.jstring(value)); }
fn success(args: int,directory: string): int {
 let result: int=run(args,directory); if(web.field_int(result,"status") != 0){println(web.field_text(result,"output"));return 0;}return 1;
}
