import web;
import strings;
fn name(value: string): int {
 let n: int = str_len(value); if (n < 3 || n > 64) { return 0; }
 let i: int = 0;
 while (i < n) { let c: int = str_char_at(value, i); if ((c < 97 || c > 122) && (c < 48 || c > 57) && c != 45) { return 0; } i = i + 1; }
 return str_char_at(value, 0) >= 97 && str_char_at(value, 0) <= 122 && str_char_at(value, n - 1) != 45;
}
fn version(value: string): int {
 let n: int = str_len(value); if (n < 5 || n > 29) { return 0; }
 let i: int = 0; let dots: int = 0; let digits: int = 0; let first: int = 0; let number: int = 0;
 while (i < n) {
  let c: int = str_char_at(value, i);
  if (c == 46) { if (digits == 0 || dots >= 2) { return 0; } dots = dots + 1; digits = 0; number = 0; }
  else { if (c < 48 || c > 57 || digits >= 9 || (digits > 0 && first == 48)) { return 0; } if (digits == 0) { first = c; } digits = digits + 1; number = number * 10 + c - 48; }
  i = i + 1;
 }
 return dots == 2 && digits > 0;
}
fn component(value: string, wanted: int): int {
 let part: int = 0; let i: int = 0; let out: int = 0;
 while (i < str_len(value)) { let c: int = str_char_at(value, i); if (c == 46) { part = part + 1; } else { if (part == wanted) { out = out * 10 + c - 48; } } i = i + 1; }
 return out;
}
fn commit(value: string): int {
 if (str_len(value) != 40) { return 0; } let i: int = 0;
 while (i < 40) { let c: int = str_char_at(value, i); if ((c < 48 || c > 57) && (c < 97 || c > 102)) { return 0; } i = i + 1; } return 1;
}
fn path(value: string): int {
 if (str_len(value) == 0 || str_len(value) > 150 || str_contains(value, "..") != 0 || str_char_at(value, 0) == 47) { return 0; }
 let i: int = 0; while (i < str_len(value)) { let c: int = str_char_at(value, i); if ((c < 97 || c > 122) && (c < 65 || c > 90) && (c < 48 || c > 57) && c != 45 && c != 95 && c != 46 && c != 47) { return 0; } i = i + 1; } return 1;
}
fn repo_owner(value: string): string {
 if (web.starts(value, "https://github.com/") == 0) { return ""; }
 let rest: string = str_sub(value, 19, str_len(value) - 19); let i: int = 0;
 while (i < str_len(rest) && str_char_at(rest, i) != 47) { i = i + 1; }
 if (i == 0 || i == str_len(rest) || web.valid(str_sub(rest, 0, i), "login") == 0) { return ""; }
 let repo: string = str_sub(rest, i + 1, str_len(rest) - i - 1);
 if (path(repo) == 0 || str_contains(repo, "/") != 0) { return ""; } return str_sub(rest, 0, i);
}
fn valid(value: int): int {
 if (web.kind(value) != 4 || name(web.field_text(value, "name")) == 0 || version(web.field_text(value, "version")) == 0 || commit(web.field_text(value, "git_commit")) == 0 || path(web.field_text(value, "module")) == 0 || str_len(web.field_text(value,"module")) < 4 || web.equal(str_sub(web.field_text(value,"module"),str_len(web.field_text(value,"module"))-3,3),".fg") == 0 || str_len(repo_owner(web.field_text(value, "repository_url"))) == 0) { return 0; }
 if (web.required(value, "description", 3) == 0 || web.chars(web.field_text(value, "description")) > 500 || web.required(value, "license", 3) == 0 || web.chars(web.field_text(value, "license")) > 100 || web.optional(value, "readme", 3) == 0 || web.chars(web.field_text(value, "readme")) > 100000) { return 0; }
 let deps: int = web.get(value, "dependencies"); if (web.kind(deps) != 4 || web.count(deps) > 32) { return 0; }
 let keys: int = web.keys(deps); let i: int = 0;
 while (i < web.count(keys)) { let key: string = web.text(web.at(keys, i)); if (name(key) == 0 || web.kind(web.get(deps, key)) != 3 || version(web.field_text(deps, key)) == 0 || web.equal(key, web.field_text(value, "name")) != 0) { return 0; } i = i + 1; }
 let native_info: int = web.get(value, "native");
 if (web.kind(native_info) != 0) {
  if (web.kind(native_info) != 4 || path(web.field_text(native_info, "library")) == 0 || str_contains(web.field_text(native_info, "library"), "/") != 0 || path(web.field_text(native_info, "cmake_target")) == 0 || web.string_array(web.get(native_info, "pkg_config")) == 0 || web.count(web.get(native_info,"pkg_config")) > 32) { return 0; }
  let pkg: int = web.get(native_info, "pkg_config"); i = 0;
  while (i < web.count(pkg)) { if (path(web.text(web.at(pkg, i))) == 0 || str_contains(web.text(web.at(pkg, i)), "/") != 0 || web.starts(web.text(web.at(pkg,i)),"-") != 0) { return 0; } i = i + 1; }
 }
 let javascript: int=web.get(value,"javascript");
 if(web.kind(javascript)!=0 && (web.kind(javascript)!=4 || path(web.field_text(javascript,"entry"))==0 || path(web.field_text(javascript,"package_file"))==0)){return 0;}
 return 1;
}
