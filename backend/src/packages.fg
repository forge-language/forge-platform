import web;
import postgres;
import database;
import auth;
import manifest;
import strings;
import repository;
import artifacts;
import cache;
fn list(conn: int, request: int, client: int, key: string): int {
 let search: string = web.query(request, "q"); if (web.chars(search) > 100) { return web.validation(request, "search too long"); }
 return database.cached_response(conn, request, "SELECT COALESCE(jsonb_agg(item ORDER BY item->>'name'),'[]'::jsonb)::text FROM (SELECT r.manifest || jsonb_build_object('owner',p.owner_name,'published_at',r.published_at) AS item FROM packages p JOIN LATERAL (SELECT * FROM releases WHERE name=p.name ORDER BY major DESC,minor DESC,patch DESC LIMIT 1) r ON true WHERE p.name ILIKE '%'||$1||'%' OR r.manifest->>'description' ILIKE '%'||$1||'%' ORDER BY p.name LIMIT 100) t", database.args1(search), 200,client,key);
}
fn detail(conn: int, request: int, name: string, client: int, key: string): int {
 return database.cached_response(conn, request, "SELECT jsonb_build_object('name',p.name,'owner',p.owner_name,'versions',COALESCE((SELECT jsonb_agg(r.manifest || jsonb_build_object('published_at',r.published_at) ORDER BY major DESC,minor DESC,patch DESC) FROM releases r WHERE r.name=p.name),'[]'::jsonb))::text FROM packages p WHERE name=$1", database.args1(name), 200,client,key);
}
fn release(conn: int, request: int, name: string, version: string, client: int, key: string): int {
 return database.cached_response(conn, request, "SELECT manifest::text FROM releases WHERE name=$1 AND version=$2", database.args2(name, version), 200,client,key);
}
fn owner_args(user: int,name: string): int {let args: int=database.args2(name,web.field_text(user,"sub"));web.push(args,web.jstring(web.field_text(user,"github_id")));return args;}
extern fn platform_pool(): int;
fn publish(request: int, user: int): int {
 if (web.kind(user) != 4) { return web.error(request, 401, "unauthorized"); }
 if (web.rate(str_concat("publish:", web.field_text(user, "github_id")), 30, 600) == 0) { return web.error(request, 429, "rate_limit"); }
 let submitted: int=web.request_json(request);let input: int=submitted;
 if(web.equal(web.path(request),"/api/packages")!=0){
  if(manifest.valid(submitted)==0){return web.validation(request,"invalid release manifest");}
  input=web.object();web.set(input,"repository_url",web.get(submitted,"repository_url"));web.set(input,"ref",web.get(submitted,"git_commit"));web.set(input,"provided_manifest",submitted);
 }
 let checked: int=repository.inspect(input);let status: int=web.field_int(checked,"status");
 if(status!=200){if(status<400){status=503;}return web.respond(request,status,web.dump(web.get(checked,"data")));}
 let data: int=web.get(checked,"data");let value: int=web.get(data,"manifest");let report: int=web.get(data,"inspection");
 let scan_status: string=web.field_text(report,"status");
 if(web.kind(report)!=4 || web.equal(web.field_text(report,"policy"),"forge-source-inspection-v1")==0 || web.equal(web.field_text(report,"repository"),web.field_text(value,"repository_url"))==0 || web.equal(web.field_text(report,"git_commit"),web.field_text(value,"git_commit"))==0 || (web.equal(scan_status,"passed")==0 && web.equal(scan_status,"review_required")==0 && web.equal(scan_status,"blocked")==0)){return web.error(request,503,"invalid_inspection_report");}
 if(manifest.valid(value)==0){return web.validation(request,"repository module.json contains an invalid release manifest");}
 if(repository.authorized(data,user)==0){return web.error(request,403,"repository_owner_mismatch");}
 if(web.equal(web.field_text(report,"status"),"blocked")!=0){let rejected: int=web.object();web.set(rejected,"error",web.jstring("repository_rejected"));web.set(rejected,"message",web.jstring("Repository inspection found blocked risks"));web.set(rejected,"inspection",report);return web.respond(request,422,web.dump(rejected));}
 if(web.equal(web.field_text(report,"status"),"review_required")!=0 && web.boolean(web.get(submitted,"acknowledge_review"))==0){return web.validation(request,"Manual source review must be acknowledged before registering this commit");}
 if(artifacts.build(value)==0){return web.error(request,502,"artifact_publish_failed");}
 let conn: int=postgres.acquire(platform_pool());if(conn==0){return web.error(request,503,"unavailable");}
 let result: int=store(conn,request,user,value);postgres.release(platform_pool(),conn);return result;
}
fn store(conn: int,request: int,user: int,value: int): int {
 if (postgres.begin(conn) == 0) { return web.error(request, 500, "internal"); }
 let name: string = web.field_text(value, "name"); let version: string = web.field_text(value, "version");
 let lock: int = database.query(conn, "SELECT pg_advisory_xact_lock(hashtextextended($1,19))", database.args1(name)); let ok: int = postgres.ok(lock); postgres.clear(lock);
 if (ok == 0) { postgres.rollback(conn); return web.error(request, 500, "internal"); }
 let owner: int = database.fetch(conn, "SELECT to_jsonb(owner_id)::text FROM packages WHERE name=$1", database.args1(name));
 if (web.kind(owner) != 0 && auth.admin(user) == 0 && web.equal(web.text(owner), web.field_text(user, "github_id")) == 0) { postgres.rollback(conn); return web.error(request, 403, "package_owner_mismatch"); }
 let legacy: int=database.exists(conn,"SELECT EXISTS(SELECT 1 FROM packages WHERE name=$1 AND owner_id IS NULL)",database.args1(name));
 if(legacy!=0 && auth.admin(user)==0){postgres.rollback(conn);return web.error(request,403,"legacy_owner_requires_admin_migration");}
 let present: int = database.exists(conn, "SELECT EXISTS(SELECT 1 FROM releases WHERE name=$1 AND version=$2)", database.args2(name,version));
 if (present != 0) { postgres.rollback(conn); if (present < 0) { return web.error(request, 500, "internal"); } return web.error(request, 409, "immutable_release"); }
 let row: int = database.query(conn, "INSERT INTO packages(name,owner_name,owner_id) VALUES($1,$2,$3) ON CONFLICT(name) DO UPDATE SET owner_id=COALESCE(packages.owner_id,EXCLUDED.owner_id)", owner_args(user,name)); ok = postgres.ok(row); postgres.clear(row);
 let args: int = database.args2(name,version); web.push(args, web.jstring(web.dump(value))); web.push(args, web.number(manifest.component(version,0))); web.push(args,web.number(manifest.component(version,1))); web.push(args,web.number(manifest.component(version,2)));
 if (ok != 0) { row = database.query(conn, "INSERT INTO releases(name,version,manifest,major,minor,patch) VALUES($1,$2,$3::jsonb,$4::int,$5::int,$6::int)",args); ok=postgres.ok(row); postgres.clear(row); }
 if (ok == 0 || postgres.commit(conn) == 0) { postgres.rollback(conn); return web.error(request, 500, "internal"); }
 cache.invalidate();
 return web.respond(request, 201, web.dump(value));
}
