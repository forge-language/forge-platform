  "measurement_script": "from pathlib import Path\nimport hashlib,json,subprocess,statistics,random,platform,re,time,os\nbase=Path('/tmp/forge-scheduler-notify-20261009')\nr=[];probes=[]\ndef invoke(variant,workers,probe=False):\n binary=base/(variant+('-probe' if probe else '-bench'))\n p=subprocess.run([str(binary),'throughput','100000',str(workers)],capture_output=True,text=True,check=True,timeout=20)\n values=p.stdout.strip().splitlines()[-1].split(',')\n record=dict(variant=variant,workers=workers,wall_ms=float(values[2]),cpu_ms=float(values[3]),completed=int(values[4]))\n assert record['completed']==100000\n if probe:\n  match=re.search(r'main_waits=(\\d+) main_cpu_ms=([0-9.]+)',p.stderr);assert match,p.stderr\n  record.update(main_waits=int(match[1]),main_cpu_ms=float(match[2]))\n return record\nfor workers in [1,2,4]:\n for variant in ['before','after']:\n  for _ in range(2):invoke(variant,workers)\nfor trial in range(15):\n for workers in ([1,2,4] if trial%2==0 else [4,2,1]):\n  for variant in (['before','after'] if trial%2==0 else ['after','before']):\n   r.append(dict(trial=trial,**invoke(variant,workers)))\nfor trial in range(5):\n for workers in [1,2,4]:\n  for variant in (['before','after'] if trial%2==0 else ['after','before']):\n   probes.append(dict(trial=trial,**invoke(variant,workers,True)))\nsummary=[];rng=random.Random(20261009)\nfor workers in [1,2,4]:\n before=[x for x in r if x['workers']==workers and x['variant']=='before']\n after=[x for x in r if x['workers']==workers and x['variant']=='after']\n ratios=[b['wall_ms']/a['wall_ms'] for b,a in zip(before,after)]\n boot=sorted(statistics.median(rng.choices(ratios,k=len(ratios))) for _ in range(10000))\n summary.append(dict(workers=workers,before_wall_median_ms=statistics.median(x['wall_ms'] for x in before),after_wall_median_ms=statistics.median(x['wall_ms'] for x in after),before_cpu_median_ms=statistics.median(x['cpu_ms'] for x in before),after_cpu_median_ms=statistics.median(x['cpu_ms'] for x in after),paired_speedup_median=statistics.median(ratios),paired_bootstrap_median_95pct=[boot[249],boot[9749]],before_wall_range_ms=[min(x['wall_ms'] for x in before),max(x['wall_ms'] for x in before)],after_wall_range_ms=[min(x['wall_ms'] for x in after),max(x['wall_ms'] for x in after)],before_main_waits_median=statistics.median(x['main_waits'] for x in probes if x['workers']==workers and x['variant']=='before'),after_main_waits_median=statistics.median(x['main_waits'] for x in probes if x['workers']==workers and x['variant']=='after'),before_main_cpu_median_ms=statistics.median(x['main_cpu_ms'] for x in probes if x['workers']==workers and x['variant']=='before'),after_main_cpu_median_ms=statistics.median(x['main_cpu_ms'] for x in probes if x['workers']==workers and x['variant']=='after')))\nresult=dict(scope='Shared-host runtime microbenchmark, same 100000 yield-once coroutines in one process. Spawn/destruction outside wall/process CPU timing. No Rust comparison. Main-thread wait/CPU diagnostics are separate instrumented binaries and not mixed with timing samples.',time_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),platform=platform.platform(),cpu_count=os.cpu_count(),cpu_model=next((x.split(':',1)[1].strip() for x in Path('/proc/cpuinfo').read_text().splitlines() if x.startswith('model name')),None),compiler=subprocess.check_output(['cc','--version'],text=True).splitlines()[0],flags=['-std=c11','-O3','-D_GNU_SOURCE','-lpthread'],before_runtime_commit='39ab3daa90f15852cbbf4dd97f5d4c1502bd392d',source_sha256={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in [base/'before/src/scheduler.c',Path('/home/helloworld0822/coding/forge-runtime/src/scheduler.c'),Path('/home/helloworld0822/coding/forge-benchmarks/benchmark/scheduler_bench.c'),base/'wait-probe.c',base/'probe-bench.c']},binary_sha256={x:hashlib.sha256((base/x).read_bytes()).hexdigest() for x in ['before-bench','after-bench','before-probe','after-probe']},warmups_per_variant_workers=2,repeats=15,diagnostic_repeats=5,summary=summary,samples=r,diagnostic_samples=probes)\n(base/'results.json').write_text(json.dumps(result,indent=2)+'\\n');print(json.dumps(summary,indent=2))\n",
  "diagnostic_sources": {
    "wait-probe.c": "#define _POSIX_C_SOURCE 200809L\n#include \"forge/thread.h\"\n#include <pthread.h>\n#include <stdio.h>\n#include <time.h>\nstatic pthread_t main_thread;\nstatic unsigned long waits;\nstatic struct timespec start;\nvoid __real_fr_cond_wait(fr_cond_t *,fr_mutex_t *);\nvoid probe_begin(void) {main_thread=pthread_self();waits=0;clock_gettime(CLOCK_THREAD_CPUTIME_ID,&start);}\nvoid __wrap_fr_cond_wait(fr_cond_t *c,fr_mutex_t *m) {if(pthread_equal(pthread_self(),main_thread))waits++;__real_fr_cond_wait(c,m);}\nvoid probe_end(void) {struct timespec end;clock_gettime(CLOCK_THREAD_CPUTIME_ID,&end);fprintf(stderr,\"main_waits=%lu main_cpu_ms=%.3f\\n\",waits,(end.tv_sec-start.tv_sec)*1000.0+(end.tv_nsec-start.tv_nsec)/1000000.0);}\n",
    "probe-bench.c": "#define _POSIX_C_SOURCE 200809L\n#include \"forge_runtime.h\"\n#include \"forge/event.h\"\n#include \"forge/thread.h\"\n#include <errno.h>\n#include <stdatomic.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <time.h>\n#include <unistd.h>\nextern void probe_begin(void);\nextern void probe_end(void);\n\ntypedef struct { int fd; unsigned milliseconds; } io_state_t;\nstatic void *writer(void *arg) {\n    io_state_t *s = arg;\n    struct timespec delay = {s->milliseconds / 1000, (s->milliseconds % 1000) * 1000000L};\n    nanosleep(&delay, NULL);\n    if (write(s->fd, \"x\", 1) != 1) exit(1);\n    return NULL;\n}\nstatic fr_coro_status_t reader(fr_coro_t *coro, void *arg) {\n    io_state_t *s = arg;\n    int64_t ready = fr_await_fd(coro, s->fd, FR_EVENT_READ);\n    if (ready < 0) exit(1);\n    if (!ready) return FR_CORO_WAITING_IO;\n    char c;\n    if (read(s->fd, &c, 1) != 1) exit(1);\n    return FR_CORO_DONE;\n}\nstatic double elapsed(struct timespec a, struct timespec b) {\n    return (b.tv_sec - a.tv_sec) * 1000.0 + (b.tv_nsec - a.tv_nsec) / 1000000.0;\n}\n\ntypedef struct { atomic_size_t *completed; int yielded; } task_state_t;\nstatic fr_coro_status_t task(fr_coro_t *coro, void *arg) {\n    task_state_t *s = arg;\n    if (!s->yielded) { s->yielded = 1; return fr_yield(coro); }\n    atomic_fetch_add_explicit(s->completed, 1, memory_order_relaxed);\n    return FR_CORO_DONE;\n}\nstatic int throughput(size_t count, int workers) {\n    atomic_size_t completed = 0;\n    fr_scheduler_t *sched = fr_scheduler_create(workers);\n    fr_process_t *proc = fr_process_create(\"throughput\");\n    if (!sched || !proc) return 1;\n    fr_scheduler_add_process(sched, proc);\n    for (size_t i = 0; i < count; i++) {\n        task_state_t *state = malloc(sizeof(*state));\n        if (!state) return 1;\n        *state = (task_state_t){&completed, 0};\n        if (!fr_coro_spawn(proc, task, state, sizeof(*state))) return 1;\n    }\n    struct timespec cpu_start, cpu_end, wall_start, wall_end;\n    clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &cpu_start);\n    clock_gettime(CLOCK_MONOTONIC, &wall_start);\n    probe_begin(); fr_scheduler_run(sched); probe_end();\n    clock_gettime(CLOCK_MONOTONIC, &wall_end);\n    clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &cpu_end);\n    size_t result = atomic_load(&completed);\n    printf(\"coroutines,workers,wall_ms,process_cpu_ms,completed\\n%zu,%d,%.3f,%.3f,%zu\\n\",\n           count, workers, elapsed(wall_start, wall_end), elapsed(cpu_start, cpu_end), result);\n    fr_scheduler_destroy(sched);\n    return result != count;\n}\n\nstatic unsigned long number(const char *text, unsigned long min, unsigned long max) {\n    char *end;\n    errno = 0;\n    unsigned long value = strtoul(text, &end, 10);\n    if (errno || end == text || *end || value < min || value > max) return 0;\n    return value;\n}\nint main(int argc, char **argv) {\n    if (argc > 1 && strcmp(argv[1], \"throughput\") == 0) {\n        if (argc != 4) return 1;\n        unsigned long count = number(argv[2], 1, 1000000);\n        unsigned long workers = number(argv[3], 1, 32);\n        return count && workers ? throughput(count, (int)workers) : 1;\n    }\n    unsigned ms = 500;\n    if (argc > 2) return 1;\n    if (argc == 2) {\n        unsigned long value = number(argv[1], 50, 10000);\n        if (!value) return 1;\n        ms = (unsigned)value;\n    }\n    int fds[2];\n    if (pipe(fds)) return 1;\n    fr_scheduler_t *sched = fr_scheduler_create(2);\n    fr_process_t *proc = fr_process_create(\"idle-io\");\n    if (!sched || !proc) return 1;\n    fr_scheduler_add_process(sched, proc);\n    io_state_t *state = malloc(sizeof(*state));\n    if (!state) return 1;\n    *state = (io_state_t){fds[0], ms};\n    if (!fr_coro_spawn(proc, reader, state, sizeof(*state))) return 1;\n    io_state_t write_state = {fds[1], ms};\n    fr_thread_t *thread;\n    struct timespec cpu_start, cpu_end, wall_start, wall_end;\n    clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &cpu_start);\n    clock_gettime(CLOCK_MONOTONIC, &wall_start);\n    if (fr_thread_start(&thread, writer, &write_state)) return 1;\n    probe_begin(); fr_scheduler_run(sched); probe_end();\n    fr_thread_join(thread);\n    clock_gettime(CLOCK_MONOTONIC, &wall_end);\n    clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &cpu_end);\n    printf(\"wait_ms,wall_ms,process_cpu_ms\\n%u,%.3f,%.3f\\n\", ms,\n           elapsed(wall_start, wall_end), elapsed(cpu_start, cpu_end));\n    fr_scheduler_destroy(sched);\n    close(fds[0]); close(fds[1]);\n    return 0;\n}\n"
  },
